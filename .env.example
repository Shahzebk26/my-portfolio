# PostgreSQL URL reachable from Vercel. Replace the entire value with your provider's
# real public/TLS URL. Do not paste this example into Vercel as DATABASE_URL.
# DATABASE_URL=postgresql://USER:PASSWORD@PUBLIC_HOST:5432/DATABASE?sslmode=verify-full

# Cloudinary image storage (recommended for production uploads).
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Set strong, unique values before deploying.
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_TOKEN=replace-with-a-long-random-secret
