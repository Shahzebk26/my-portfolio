# Set this to the pooled PostgreSQL connection URL from your Vercel Marketplace
# database integration (Neon is a supported option). Leave blank locally if you
# want to use the JSON files in data/ instead.
DATABASE_URL=

# Cloudinary image storage (recommended for production uploads).
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Set strong, unique values before deploying.
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_TOKEN=replace-with-a-long-random-secret
